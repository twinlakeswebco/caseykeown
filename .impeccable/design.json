  "narrative": {
    "northStar": "Hometown magazine",
    "overview": "The approved “Hometown magazine” direction uses warm paper, condensed deep-blue headlines, restrained red punctuation, and a large real portrait. Its character is local, confident, and personable; the density comes from editorial type, generous gutters, and a ruled archive.\n\nDepth stays flat. Photography and full-width blue bands provide visual weight, while publisher metadata and quiet captions give the page the feel of a personal magazine profile.",
    "keyCharacteristics": [
      "Warm ivory paper with blue type and restrained red accents.",
      "Condensed, heavy headlines paired with plain body copy and a serif biography lead.",
      "Real photography with visible attribution.",
      "Square controls, thin rules, and flat surfaces."
    ],
    "rules": [
      {
        "name": "The Red Punctuation Rule",
        "body": "Use red for small accents and interaction feedback; blue and paper carry the large surfaces.",
        "section": "colors"
      },
      {
        "name": "The Flat Paper Rule",
        "body": "Separate content with space, thin rules, and inverse blue bands; keep surfaces free of decorative shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the named palette and condensed headline family.",
      "Do keep visual headings at or below 96px.",
      "Do retain source and photography attribution.",
      "Do stack columns and keep press metadata horizontal on small screens.",
      "Do preserve visible keyboard focus and reduced-motion behavior."
    ],
    "donts": [
      "Don't introduce generated identity imagery.",
      "Don't add raised cards, rounded pills, gradients, or decorative shadows to this flat editorial system.",
      "Don't substitute restaurant menu or booking conventions for the personal profile."
    ]
